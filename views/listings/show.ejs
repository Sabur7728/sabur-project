<% layout("/layouts/boilerplate") -%>
  <script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
    

  </script>
  <div class="row mt-3">

    <!-- Listing title -->
    <div class="col-8 offset-3">
      <h3>
        <%= listing.title %>
      </h3>
    </div>

    <!-- Listing details -->
    <div class="card col-6 offset-3 mt-2 show-card listing-card">

      <!-- Listing image -->
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image" />

      <div class="card-body">

        <!-- Listing owner -->
        <p class="card-text mt-2">
          <i>
            Owned by:
            <%= listing.owner.username %>
          </i>
        </p>

        <!-- Listing description -->
        <p class="card-text">
          <%= listing.description %>
        </p>

        <!-- Listing price -->
        <p class="card-text">
          &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
        </p>

        <!-- Listing location -->
        <p class="card-text">
          <%= listing.location %>
        </p>

        <!-- Listing country -->
        <p class="card-text">
          <%= listing.country %>
        </p>

      </div>
    </div>
  </div>


  <!-- Show Edit/Delete buttons only to the listing owner -->
  <% if (currUser && listing.owner._id.equals(currUser._id)) { %>

    <div class="btns mb-5">

      <!-- Edit listing -->
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">
        Edit
      </a>

      <!-- Delete listing using method override -->
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">
          Delete
        </button>
      </form>

    </div>

    <% } %>


      <!-- Reviews section -->
      <div class="col-8 offset-3 mb-3">

        <!-- Show review form only to logged-in users -->
        <% if (currUser) { %>
          <hr>

          <h4>Leave A Review:</h4>

          <!-- Review form -->
          <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">

            <!-- Rating -->
            <div class="mt-3 mb-3">

              <label for="rating" class="form-label">
                Rating
              </label>


              <!-- Star rating -->
              <fieldset class="starability-slot">

                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />

                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>

                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>

                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>

                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>

                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>

              </fieldset>

              <!-- Review comment -->
              <div class="mt-3 mb-4">

                <label for="comment">
                  Comments:
                </label>

                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                  required></textarea>


                <div class="invalid-feedback">
                  Please Add Some Comments for Reviews
                </div>

              </div>

              <!-- Submit review -->
              <button class="btn btn-outline-dark">
                Submit
              </button>

            </div>
          </form>

          <hr>

          <% } %>


            <!-- Display all reviews -->

            <% if(listing.reviews.length> 0) { %>
              <div class="row">
                <p>
                  <b>All Reviews:</b>
                </p>

                <% for (const review of listing.reviews) { %>

                  <!-- Single review card -->
                  <div class="card col-5 ms-3 mb-4">

                    <div class="card-body">

                      <!-- Review author -->
                      <h5 class="card-title">
                        <%= review.author.username %>
                      </h5>

                      <!-- Review rating -->
                      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>

                      <!-- Review comment -->
                      <div class="card-text">
                        <%= review.comment %>
                      </div>

                      <!-- Delete review only by its author -->
                      <% if (currUser && review.author._id.equals(currUser._id)) { %>

                        <form class="mb-3 mt-3" method="POST"
                          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                          <button class="btn btn-sm btn-dark">
                            Delete
                          </button>

                        </form>

                        <% } %>

                    </div>
                  </div>

                  <% } %>
              </div>
              <% }%>

      </div>
      <div class="col-8 offset-3">
        <h3>Where You'll be</h3>
        <div id="map">


        </div>

      </div>

      </div>
      <script src="/js/map.js"></script>